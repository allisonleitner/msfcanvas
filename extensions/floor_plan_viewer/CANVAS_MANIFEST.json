{
    "sdk_version": "0.112.0",
    "plugin_version": "0.9.1",
    "name": "floor_plan_viewer",
    "description": "Interactive floor plan viewer with room & resource scheduling, Canvas calendar integration, and equipment management.",
    "url_permissions": [
        {
            "url": "https://*.canvasmedical.com/*",
            "permissions": []
        },
        {
            "url": "https://api.sonos.com/*",
            "permissions": []
        },
        {
            "url": "https://api.ws.sonos.com/*",
            "permissions": []
        }
    ],
    "components": {
        "applications": [
            {
                "class": "floor_plan_viewer.applications.my_application:MyApplication",
                "name": "Floor Plan",
                "description": "Interactive floor plan with real-time room availability, resource scheduling, and Canvas calendar integration.",
                "scope": "global",
                "icon": "assets/logo.png"
            }
        ],
        "protocols": [
            {
                "class": "floor_plan_viewer.applications.my_application:FloorPlanApi",
                "description": "REST API for rooms, resources, assignments, and Canvas FHIR integration.",
                "data_access": {
                    "event": "",
                    "read": ["Appointment", "Patient", "Staff"],
                    "write": []
                }
            }
        ],
        "commands": [],
        "content": [],
        "effects": [],
        "views": []
    },
    "custom_data": {
        "namespace": "floor__plan__viewer",
        "access": "read_write"
    },
    "secrets": [
        "FHIR_CLIENT_ID",
        "FHIR_CLIENT_SECRET",
        "SONOS_CLIENT_ID",
        "SONOS_CLIENT_SECRET",
        "SONOS_REFRESH_TOKEN"
    ],
    "tags": {},
    "references": [],
    "license": "",
    "diagram": false,
    "readme": "./README.md"
}
